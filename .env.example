# Copy to .env before running `docker compose up --build`.
# Real values only needed here — placeholders below are NOT valid credentials.

DB_USERNAME=vmp
DB_PASSWORD=change-me

# Any long random string works for a local demo.
JWT_SECRET=change-me-to-a-long-random-string

# Optional: leave unset for a non-functional (log-only, no real sends) mail setup.
MAIL_HOST=smtp.example.com
MAIL_USERNAME=demo
MAIL_PASSWORD=demo
