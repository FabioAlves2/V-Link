# Optional. Plain `npm run dev`/`npm run build` don't need this file at all —
# axiosConfig.js falls back to http://localhost:8080 automatically.
# Only needed if the backend isn't reachable at the default URL (e.g. the
# docker-compose demo, which bakes this in at build time via a Docker build-arg).
VITE_API_BASE_URL=http://localhost:8080
